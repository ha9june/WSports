<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper.review">
	
	<insert id="insertReview" parameterType="review">
	insert into review(user_id,match_type,match_id,title,content,created_at,image) 
	values (#{userid},#{matchtype},#{matchid},#{title},#{content},#{createdat},#{image})
	</insert>
	
	<select id="selectReview" parameterType="review" resultType="review">
	 select r.*,u.nickname,
	 u.profile_image from review r
	 join user u on u.user_id=r.user_id where r.deleted=false 
	 order by r.created_at desc limit ?,?;
	</select>
	
	<update id="UpdateReview" parameterType="review">
	update set 
	where
	</update>
	
</mapper>
